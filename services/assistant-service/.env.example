APP_NAME="EventCore Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=assistant_db
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=eventcore-cache-
REDIS_PREFIX=eventcore-database-
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

JWT_SECRET=
JWT_ALGO=HS256

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# Asistente IA (DeepSeek)
# -------------------------------------------------------------------
# Clave de API de https://platform.deepseek.com (vacia -> modo mock si ASSISTANT_MOCK=true)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash = DeepSeek-V4.1-Flash (el alias deepseek-chat está obsoleto)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOOL_ITERATIONS=5
DEEPSEEK_TIMEOUT=120

# true -> el asistente responde sin DeepSeek usando reglas locales + datos reales del catalog
ASSISTANT_MOCK=false

# Servicios internos de la red Docker.
# Docker (compose inyecta el valor correcto): http://catalog-service:8000/api
# Desde el host (sin Docker):               http://localhost:8000/api/catalog
CATALOG_SERVICE_URL=http://catalog-service:8000/api

# Limite de mensajes de historial que se envian al modelo
ASSISTANT_HISTORY_LIMIT=40
