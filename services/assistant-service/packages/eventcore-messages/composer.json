{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "eventcore/messages",
    "description": "Catálogo de mensajes estándar y contrato de respuestas {code, message, data} compartido por los servicios EventCore.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "EventCore\\Messages\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EventCore\\Messages\\MessagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
