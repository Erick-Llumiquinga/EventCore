flowchart TD
    usuario(("Navegador<br/>usuario"))
    frontend["Frontend React + Vite · :5173<br/>Login · Dashboard · Flujo de reserva<br/>(booking con datos mock todavía)"]
    gateway["api-gateway<br/>Nginx · :8000<br/>/api/auth · /api/catalog · /health"]
    auth["auth-service<br/>Laravel + JWT HS256<br/>register · login · me · logout · refresh<br/>profile · password · users · roles"]
    catalog["catalog-service<br/>Laravel REST<br/>cinemas · movies · showtimes<br/>ticket-types · seats · health"]

    subgraph pg["PostgreSQL · localhost:5432 (contenedor único)"]
        authdb[("auth_db<br/>persons · users · roles")]
        catalogdb[("catalog_db<br/>cinemas · movies · auditoriums<br/>showtimes · ticket_types · seats")]
    end

    redis[("Redis · localhost:6379<br/>caché + blacklist de JWT")]

    usuario -- "HTTP :5173" --> frontend
    frontend -- "axios + Bearer JWT<br/>VITE_API_URL" --> gateway
    gateway -- "proxy /api/auth" --> auth
    gateway -- "proxy /api/catalog/<br/>(quita el prefijo)" --> catalog
    auth -. "JWT_SECRET compartido:<br/>catalog valida el token offline<br/>sin llamar a auth por HTTP" .- catalog
    auth --> authdb
    catalog --> catalogdb
    auth -- "logout: blacklist del jti" --> redis
    catalog -- "jwt.verify: revisa blacklist<br/>+ caché" --> redis

    booking["booking-service · :8003<br/>(planeado)"]
    booking -.-> gateway

    classDef browser fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef service fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d
    classDef store fill:#ffedd5,stroke:#ea580c,stroke-width:2px,color:#7c2d12
    classDef planned fill:#f1f5f9,stroke:#94a3b8,stroke-width:2px,stroke-dasharray:6 4,color:#475569

    class usuario,frontend browser
    class gateway,auth,catalog service
    class authdb,catalogdb,redis store
    class booking planned
