# Configuración de PostgreSQL
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=postgres

# Las bases de datos que tu script creará automáticamente:
POSTGRES_MULTIPLE_DATABASES=auth_db,catalog_db,assistant_db,booking_db

# Configuración de Redis
REDIS_PORT=6379
# -------------------------------------------------------------------
# Asistente IA (DeepSeek) - valores inyectados al contenedor assistant-service
# -------------------------------------------------------------------
DEEPSEEK_API_KEY=
# true mientras no haya API key: el asistente usa modo mock (datos reales del catalog)
# ponlo en false cuando configures DEEPSEEK_API_KEY
ASSISTANT_MOCK=true
